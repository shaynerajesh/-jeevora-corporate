---
const PILLARS = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>`,
    title:       "Face-to-Face Engagement",
    description: "Our brand representatives operate at the sharpest point of the sales cycle—creating trust in person, where conversions are highest.",
    color: "navy",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>`,
    title:       "Performance-First Culture",
    description: "Every team, campaign, and conversation is measured. We operate on outcomes—not activity—because our clients expect results, not reports.",
    color: "grove",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"/>`,
    title:       "Scalable Brand Architecture",
    description: "We build growth infrastructure that compounds. From market entry to national scale, our systems are designed to expand without losing execution quality.",
    color: "teal",
  },
] as const;

type C = "navy" | "grove" | "teal";
const iconBg: Record<C, string> = {
  navy:  "bg-navy-50 text-navy-700",
  grove: "bg-grove-50 text-grove-700",
  teal:  "bg-teal-400/10 text-teal-500",
};
---

<section
  id="about"
  aria-labelledby="about-heading"
  class="section-pad bg-warm-50 relative overflow-hidden"
>
  <!-- Decorative corner -->
  <div
    class="absolute top-0 right-0 w-72 h-72 bg-navy-50 rounded-bl-full opacity-60 pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="wrap relative z-10">

    <!-- Section header -->
    <div class="max-w-3xl mb-14 lg:mb-18">
      <p class="label-eyebrow reveal mb-4">Who We Are</p>
      <div class="section-divider reveal delay-100 mb-6"></div>
      <h2
        id="about-heading"
        class="reveal delay-100 font-display font-extrabold text-navy-900 text-4xl lg:text-5xl tracking-tighter leading-[1.06] mb-5"
      >
        Crafted for Brands<br class="hidden md:block" />
        That Demand Excellence
      </h2>
      <p class="reveal delay-200 text-lg text-warm-500 leading-relaxed max-w-2xl">
        In an era overwhelmed by digital noise, we provide a distinct advantage—authentic human connection at scale.
      </p>
    </div>

    <!-- Two-column body -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">

      <!-- Left: Narrative -->
      <div>
        <div class="space-y-5 text-warm-500 leading-relaxed mb-10">
          <p class="reveal text-base lg:text-[1.0625rem]">
            We are a performance-focused sales and marketing firm dedicated to customer acquisition, brand expansion, and revenue acceleration. Our methodology combines strategic rigour with practical execution—ensuring each interaction is not just seen, but felt.
          </p>
          <p class="reveal delay-100 text-base lg:text-[1.0625rem]">
            Our teams represent your brand where it matters most: face-to-face, voice-to-voice, and at the critical moments when decisions are made. We operate at the intersection of human psychology and commercial precision.
          </p>
          <p class="reveal delay-200 text-base lg:text-[1.0625rem]">
            Because ultimately, customers don't purchase products—they invest in confidence, clarity, and genuine connection. That is the standard we hold ourselves to, on every engagement.
          </p>
        </div>

        <!-- Divider -->
        <div class="reveal delay-300 flex items-center gap-4 mb-8">
          <div class="w-10 h-px bg-grove-600"></div>
          <span class="text-[0.65rem] font-bold tracking-widest uppercase text-warm-400">Our Foundation</span>
        </div>

        <!-- Mission / Vision -->
        <div class="reveal delay-400 grid sm:grid-cols-2 gap-4">
          <div class="bg-white rounded-2xl border border-warm-200 p-5 hover:border-navy-200 hover:shadow-md transition-all duration-200">
            <span class="block mb-2 text-[0.65rem] font-bold tracking-widest uppercase text-warm-400">Mission</span>
            <p class="text-sm font-semibold text-navy-900 leading-snug">
              To deliver measurable, human-led growth for ambitious brands through disciplined execution and authentic engagement.
            </p>
          </div>
          <div class="rounded-2xl p-5 text-white" style="background:linear-gradient(135deg,#1b3575 0%,#0f1d45 100%);">
            <span class="block mb-2 text-[0.65rem] font-bold tracking-widest uppercase text-navy-300">Vision</span>
            <p class="text-sm font-semibold leading-snug">
              To become the most trusted name in human-led customer acquisition and brand expansion across emerging markets.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: Pillars + stats + proof -->
      <div class="space-y-4">

        {PILLARS.map(({ icon, title, description, color }, i) => (
          <div class={`reveal delay-${i * 100 + 100} card flex gap-4 lg:gap-5 group`}>
            <div class={`flex-shrink-0 size-11 rounded-xl flex items-center justify-center ${iconBg[color]} group-hover:scale-110 transition-transform duration-200`}>
              <svg class="size-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icon} />
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-navy-900 mb-1.5 text-[0.9375rem]">{title}</h3>
              <p class="text-sm text-warm-500 leading-relaxed">{description}</p>
            </div>
          </div>
        ))}

        <!-- Stats strip -->
        <div
          class="reveal delay-400 rounded-2xl p-6 grid grid-cols-3 gap-4"
          style="background:linear-gradient(135deg,#0d6c4a 0%,#0a5038 100%);"
        >
          {(
            [
              { n: "8+",    label: "Years of\nExecution"    },
              { n: "15+",   label: "Markets\nActivated"     },
              { n: "₹50Cr+", label: "Revenue\nGenerated"   },
            ] as const
          ).map(({ n, label }) => (
            <div class="text-center">
              <p class="text-2xl font-extrabold text-white tracking-tight mb-0.5">{n}</p>
              <p class="text-[0.65rem] font-semibold text-grove-200 leading-tight whitespace-pre-line">{label}</p>
            </div>
          ))}
        </div>

        <!-- Testimonial -->
        <div class="reveal delay-500 bg-white rounded-2xl border border-warm-200 p-5">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <div
                class="relative overflow-hidden rounded-lg flex-shrink-0 border border-warm-100"
                style="width:2rem;height:2rem;"
              >
                <img
                  src="/logo.jpg"
                  alt="Jeevora"
                  width="1254" height="1254"
                  class="absolute inset-0 w-full"
                  style="height:140%;object-fit:cover;object-position:top center;"
                  decoding="async"
                />
              </div>
              <span class="text-xs font-bold text-navy-900 leading-tight">
                Jeevora<br />
                <span class="text-[0.6rem] font-semibold text-warm-400 tracking-wide uppercase">Private Limited</span>
              </span>
            </div>
            <svg class="size-7 text-warm-200 flex-shrink-0" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
              <path d="M10 8C6.7 8 4 10.7 4 14v10h10V14H7c0-1.7 1.3-3 3-3V8zm14 0c-3.3 0-6 2.7-6 6v10h10V14h-7c0-1.7 1.3-3 3-3V8z"/>
            </svg>
          </div>
          <p class="text-sm text-warm-600 italic leading-relaxed mb-3.5">
            "Jeevora didn't hand us a strategy deck—they embedded a team that executed alongside us. Revenue grew 3× in 90 days."
          </p>
          <div class="flex items-center gap-2.5">
            <div class="size-7 bg-navy-700 rounded-full flex items-center justify-center text-white text-xs font-bold flex-shrink-0">R</div>
            <div>
              <p class="text-xs font-bold text-navy-900 leading-tight">Rahul Mehta</p>
              <p class="text-[0.65rem] text-warm-400 font-medium">VP Growth, FinEdge Technologies</p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>
