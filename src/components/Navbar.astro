---
const NAV_LINKS = [
  { label: "About",     href: "#about"    },
  { label: "Approach",  href: "#approach" },
  { label: "Solutions", href: "#services" },
  { label: "Insights",  href: "#insights" },
  { label: "Careers",   href: "#careers"  },
  { label: "Partner",   href: "#partner"  },
] as const;
---

<!-- Sticky header — starts transparent, gains frosted glass on scroll via JS -->
<header
  id="navbar"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300"
  role="banner"
>
  <div class="wrap">
    <nav
      class="flex items-center justify-between h-18 lg:h-20"
      aria-label="Main navigation"
    >

      <!-- ── Logo ── -->
      <!--
        Logo is 1254×1254 (square). We show the full mark cropped from the top
        at a fixed height — the icon + "Jeevora" wordmark fill ~70% of the image
        height so they remain crisply visible in the navbar at h-14/h-16.
      -->
      <a
        href="#home"
        class="flex-shrink-0 flex items-center group"
        aria-label="Jeevora — back to top"
      >
        <!-- Clipping container: fixed height, width = height (square logo) -->
        <div
          class="relative overflow-hidden select-none"
          style="
            height: 3.25rem;
            width:  3.25rem;
            border-radius: 0.5rem;
          "
        >
          <!--
            Show only the TOP 70% of the square logo (icon + wordmark).
            We set the image taller than the container and shift it up with
            object-position so the icon sits at the top and the small
            "JEEVORA PRIVATE LIMITED" line is cropped off the bottom.
          -->
          <img
            src="/logo.jpg"
            alt="Jeevora Private Limited"
            width="1254"
            height="1254"
            class="absolute inset-0 w-full select-none"
            style="
              height: 143%;
              object-fit: cover;
              object-position: top center;
            "
            decoding="async"
          />
        </div>

        <!-- Wordmark beside the mark (always visible, hides nothing) -->
        <span class="ml-2.5 flex flex-col leading-none select-none">
          <span
            class="font-display font-extrabold text-lg tracking-tight text-navy-900
                   group-hover:text-navy-700 transition-colors duration-150"
          >
            Jeevora
          </span>
          <span class="text-[0.55rem] font-semibold tracking-[0.12em] uppercase text-grove-600 mt-0.5">
            Private Limited
          </span>
        </span>
      </a>

      <!-- ── Desktop nav links ── -->
      <ul class="hidden lg:flex items-center gap-0.5" role="list">
        {NAV_LINKS.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class="
                relative px-4 py-2 text-sm font-semibold text-warm-600 rounded-lg
                hover:text-navy-700 hover:bg-navy-50
                transition-all duration-150
                after:absolute after:inset-x-4 after:bottom-1 after:h-0.5
                after:rounded-full after:bg-grove-600 after:scale-x-0
                after:transition-transform after:duration-200
                hover:after:scale-x-100
              "
            >
              {label}
            </a>
          </li>
        ))}
      </ul>

      <!-- ── Desktop CTA ── -->
      <div class="hidden lg:flex items-center gap-3">
        <a href="#contact" class="btn-primary text-sm">
          Start a Conversation
          <!-- Arrow icon -->
          <svg
            class="size-4 flex-shrink-0"
            viewBox="0 0 16 16" fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8h10M9 4l4 4-4 4"
              stroke="currentColor" stroke-width="1.75"
              stroke-linecap="round" stroke-linejoin="round"
            />
          </svg>
        </a>
      </div>

      <!-- ── Mobile menu button ── -->
      <button
        id="menu-btn"
        type="button"
        class="
          lg:hidden flex items-center justify-center size-10 rounded-xl
          text-navy-700 hover:bg-navy-50 transition-colors duration-150
          focus-visible:outline-2 focus-visible:outline-grove-600
        "
        aria-controls="mobile-menu"
        aria-expanded="false"
        aria-label="Toggle navigation menu"
      >
        <!-- Hamburger -->
        <svg id="icon-open" class="size-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd" clip-rule="evenodd"
            d="M3 6h14a1 1 0 010 2H3a1 1 0 010-2zm0 4h14a1 1 0 010 2H3a1 1 0 010-2zm0 4h14a1 1 0 010 2H3a1 1 0 010-2z"
          />
        </svg>
        <!-- Close X -->
        <svg id="icon-close" class="size-5 hidden" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd" clip-rule="evenodd"
            d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414
               1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10
               11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10
               4.293 5.707a1 1 0 010-1.414z"
          />
        </svg>
      </button>
    </nav>
  </div>

  <!-- ── Mobile menu dropdown ── -->
  <div
    id="mobile-menu"
    class="lg:hidden bg-white/95 backdrop-blur-xl border-t border-warm-100 shadow-lg"
    aria-label="Mobile navigation"
  >
    <div class="wrap py-4 flex flex-col gap-1">
      {NAV_LINKS.map(({ label, href }) => (
        <a
          href={href}
          class="
            flex items-center px-4 py-3 text-sm font-semibold text-warm-700
            rounded-xl hover:text-navy-700 hover:bg-navy-50 transition-all duration-150
          "
        >
          {label}
        </a>
      ))}

      <!-- Mobile CTA -->
      <div class="pt-3 mt-1 border-t border-warm-100">
        <a href="#contact" class="btn-primary w-full justify-center">
          Start a Conversation
          <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75"
              stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<!-- Spacer so page content doesn't sit under the fixed nav -->
<div class="h-18 lg:h-20" aria-hidden="true"></div>
