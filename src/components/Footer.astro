---
const NAV_COLS = [
  {
    heading: "Company",
    links: [
      { label: "About Us",      href: "#about"      },
      { label: "Our Approach",  href: "#approach"   },
      { label: "Careers",       href: "#careers"    },
      { label: "Get in Touch",  href: "#contact"    },
    ],
  },
  {
    heading: "Solutions",
    links: [
      { label: "Field Marketing Direct", href: "#services" },
    ],
  },
  {
    heading: "Resources",
    links: [
      { label: "How We Work",     href: "#process"  },
      { label: "Why Jeevora",     href: "#why-us"   },
      { label: "Contact",         href: "#contact"  },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy Policy",    href: "#" },
      { label: "Terms of Service",  href: "#" },
      { label: "Cookie Policy",     href: "#" },
      { label: "Disclaimer",        href: "#" },
    ],
  },
] as const;

const SOCIALS = [
  {
    label: "LinkedIn",
    href:  "https://linkedin.com/company/jeevora",
    icon:  `<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/>`,
  },
  {
    label: "Instagram",
    href:  "https://instagram.com/jeevora",
    icon:  `<rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>`,
  },
  {
    label: "Twitter / X",
    href:  "https://twitter.com/jeevora",
    icon:  `<path d="M4 4l16 16M4 20L20 4"/>`,
  },
] as const;
---

<footer aria-label="Site footer" class="bg-navy-950 relative overflow-hidden">

  <div class="absolute inset-0 bg-grid opacity-10 pointer-events-none" aria-hidden="true"></div>
  <div
    class="absolute bottom-0 left-1/3 size-[500px] bg-grove-900/15 rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="wrap relative z-10">

    <div class="border-b border-white/8 py-12 lg:py-14 grid lg:grid-cols-4 gap-10 lg:gap-8">

      <div class="lg:col-span-1">

        <a href="#home" class="inline-flex items-center gap-3 mb-5 group" aria-label="Jeevora Private Limited — home">
          <img
            src="/logo-mark.svg"
            alt=""
            class="h-10 w-auto flex-shrink-0"
            width="44"
            height="27"
            decoding="async"
          />
          <span class="flex flex-col leading-none">
            <span class="font-display font-extrabold text-lg tracking-tight text-white group-hover:text-grove-300 transition-colors duration-200">Jeevora</span>
            <span class="text-[0.52rem] font-semibold tracking-[0.14em] uppercase text-navy-400 mt-0.5">Private Limited</span>
          </span>
        </a>

        <p class="text-sm text-navy-300 leading-relaxed mb-6 max-w-xs">
          Growing people, creating impact. India's premier human-led growth company — building trust through authentic engagement, field presence, and lasting brand relationships.
        </p>

        <div class="space-y-2.5">
          <a href="mailto:hello@jeevora.com" class="flex items-center gap-2.5 text-xs text-navy-300 hover:text-grove-300 transition-colors duration-200 font-medium">
            <svg class="size-3.5 text-navy-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
            </svg>
            hello@jeevora.com
          </a>
          <a href="tel:+919876543210" class="flex items-center gap-2.5 text-xs text-navy-300 hover:text-grove-300 transition-colors duration-200 font-medium">
            <svg class="size-3.5 text-navy-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
            +91 98765 43210
          </a>
          <p class="flex items-center gap-2.5 text-xs text-navy-400 font-medium">
            <svg class="size-3.5 text-navy-500 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>
            </svg>
            Bangalore, Karnataka, India
          </p>
        </div>
      </div>

      <nav aria-label="Footer navigation" class="lg:col-span-3 grid grid-cols-2 md:grid-cols-4 gap-8">
        {NAV_COLS.map(({ heading, links }) => (
          <div>
            <p class="text-[0.65rem] font-bold uppercase tracking-[0.14em] text-navy-500 mb-4">{heading}</p>
            <ul class="space-y-2.5">
              {links.map(({ label, href }) => (
                <li>
                  <a
                    href={href}
                    class="text-xs font-medium text-navy-300 hover:text-white transition-colors duration-200"
                  >
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </div>

    <div class="py-6 flex flex-col sm:flex-row items-center justify-between gap-4">

      <div class="text-center sm:text-left">
        <p class="text-xs text-navy-500 font-medium">
          &copy; {new Date().getFullYear()} Jeevora Private Limited. All rights reserved.
        </p>
        <p class="text-[0.65rem] text-navy-600 mt-0.5">
          CIN: U74999MH2024PTC000000 &nbsp;·&nbsp; Registered in Karnataka, India
        </p>
      </div>

      <div class="flex items-center gap-3">
        {SOCIALS.map(({ label, href, icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="size-8 bg-navy-800 hover:bg-grove-700 rounded-lg flex items-center justify-center transition-colors duration-200"
          >
            <svg class="size-3.5 text-navy-300 hover:text-white" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <Fragment set:html={icon} />
            </svg>
          </a>
        ))}

        <a
          href="#home"
          aria-label="Back to top"
          class="size-8 bg-navy-800 hover:bg-navy-700 rounded-lg flex items-center justify-center transition-colors duration-200 ml-1"
        >
          <svg class="size-3.5 text-navy-300" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
