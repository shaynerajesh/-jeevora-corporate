---
const PARTNER_TYPES = [
  { label: "Brand Client",           icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/>` },
  { label: "Distribution Partner",   icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/>` },
  { label: "Agency Partner",         icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 8.511c.884.284 1.5 1.128 1.5 2.097v4.286c0 1.136-.847 2.1-1.98 2.193-.34.027-.68.052-1.02.072v3.091l-3-3c-1.354 0-2.694-.055-4.02-.163a2.115 2.115 0 01-.825-.242m9.345-8.334a2.126 2.126 0 00-.476-.095 48.64 48.64 0 00-8.048 0c-1.131.094-1.976 1.057-1.976 2.192v4.286c0 .837.46 1.58 1.155 1.951m9.345-8.334V6.637c0-1.621-1.152-3.026-2.76-3.235A48.455 48.455 0 0011.25 3c-2.115 0-4.198.137-6.24.402-1.608.209-2.76 1.614-2.76 3.235v6.226c0 1.621 1.152 3.026 2.76 3.235.577.075 1.157.14 1.74.194V21l4.155-4.155"/>` },
  { label: "Referral Partner",       icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.563.563 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z"/>` },
] as const;

const BENEFITS = [
  "Revenue share on referred and co-delivered engagements",
  "Joint go-to-market strategy and execution support",
  "Access to our proprietary growth playbooks",
  "Dedicated partnership relationship manager",
  "Co-branding opportunities and joint case studies",
  "Priority access to new service offerings and markets",
] as const;
---

<section id="partner" aria-labelledby="partner-heading" class="section-pad relative overflow-hidden">

  <!-- Background -->
  <div class="absolute inset-0 bg-navy-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-grid opacity-15" aria-hidden="true"></div>
  <div
    class="absolute bottom-0 left-1/3 size-[600px] bg-grove-900/20 rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>
  <div
    class="absolute top-0 right-0 size-[400px] bg-navy-800/40 rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="wrap relative z-10">

    <!-- Header -->
    <div class="text-center mb-14 lg:mb-16">
      <div class="reveal mb-6 flex justify-center">
        <span class="
          inline-flex items-center gap-2 px-4 py-2 rounded-full
          bg-white/8 text-grove-300 border border-white/10
          text-[0.7rem] font-bold tracking-[0.12em] uppercase
        ">
          <span class="size-1.5 rounded-full bg-grove-400" style="animation:var(--animate-pulse-soft);" aria-hidden="true"></span>
          Partnership Programme
        </span>
      </div>
      <h2
        id="partner-heading"
        class="reveal delay-100 font-display font-extrabold text-white text-4xl lg:text-5xl xl:text-6xl tracking-tighter leading-[1.04] mb-5"
      >
        Accelerate Your Growth<br />
        <span class="text-grove-400">with Confidence.</span>
      </h2>
      <p class="reveal delay-200 text-lg text-navy-300 leading-relaxed max-w-2xl mx-auto">
        Whether you are launching, scaling, or redefining your market position—we provide the infrastructure, expertise, and execution capabilities to fast-track your success.
      </p>
    </div>

    <!-- Partner types + Benefits -->
    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 mb-12 lg:mb-16">

      <!-- Partner types -->
      <div class="reveal reveal-left delay-100">
        <h3 class="text-xs font-bold text-navy-400 uppercase tracking-widest mb-5">How We Can Work Together</h3>
        <div class="grid sm:grid-cols-2 gap-3">
          {PARTNER_TYPES.map(({ label, icon }) => (
            <div class="group flex items-center gap-4 bg-white/5 hover:bg-white/10 border border-white/10 hover:border-white/20 rounded-2xl p-4 transition-all duration-200 cursor-pointer">
              <div class="size-10 bg-navy-800 group-hover:bg-grove-700 rounded-xl flex items-center justify-center flex-shrink-0 transition-colors duration-200">
                <svg class="size-5 text-grove-300" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={icon} />
                </svg>
              </div>
              <span class="text-sm font-semibold text-white">{label}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Benefits -->
      <div class="reveal reveal-right delay-200">
        <h3 class="text-xs font-bold text-navy-400 uppercase tracking-widest mb-5">What You Gain</h3>
        <div class="space-y-3">
          {BENEFITS.map((b) => (
            <div class="flex items-start gap-3">
              <div class="size-5 rounded-full bg-grove-700 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="size-3 text-white" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="text-sm text-navy-100 font-medium leading-relaxed">{b}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- CTA block -->
    <div class="reveal delay-300 bg-white/5 border border-white/10 rounded-3xl p-8 lg:p-10 flex flex-col lg:flex-row items-center justify-between gap-8">
      <div class="text-center lg:text-left">
        <p class="text-xs font-bold text-grove-400 uppercase tracking-widest mb-2">Ready to Grow Together?</p>
        <h3 class="text-2xl font-extrabold text-white mb-2 leading-snug">Let's build something exceptional together.</h3>
        <p class="text-sm text-navy-300 leading-relaxed max-w-md">
          Our partnerships team will respond within 24 hours to explore how we can accelerate your growth.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 flex-shrink-0">
        <a href="#contact" class="btn-green px-7 py-4 text-base">
          Become a Client
          <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="#contact"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 text-base text-white font-semibold rounded-full border-2 border-white/20 hover:border-white/50 transition-all duration-200"
        >
          Become a Partner
        </a>
      </div>
    </div>
  </div>
</section>
