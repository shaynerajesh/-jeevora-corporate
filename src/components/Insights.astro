---
const METRICS = [
  {
    target: 500, suffix: "+", prefix: "", decimals: 0,
    label: "Brands Activated",
    sub:   "Across India and emerging markets",
    color: "navy",
  },
  {
    target: 50, suffix: "Cr+", prefix: "₹", decimals: 0,
    label: "Revenue Generated",
    sub:   "Cumulatively for our clients",
    color: "grove",
  },
  {
    target: 98, suffix: "%", prefix: "", decimals: 0,
    label: "Client Retention Rate",
    sub:   "Our clients stay, grow, and scale with us",
    color: "navy",
  },
  {
    target: 3.2, suffix: "×", prefix: "", decimals: 1,
    label: "Average Acquisition ROI",
    sub:   "Return on campaign investment",
    color: "grove",
  },
  {
    target: 15, suffix: "+", prefix: "", decimals: 0,
    label: "Markets Activated",
    sub:   "From FMCG to Financial Services",
    color: "navy",
  },
  {
    target: 4.9, suffix: "/5", prefix: "", decimals: 1,
    label: "Client Satisfaction Score",
    sub:   "Average across all engagements",
    color: "grove",
  },
] as const;

const TRACKED = [
  "Conversion efficiency",
  "Cost of acquisition",
  "Customer lifetime value",
  "Campaign ROI",
] as const;

const PROOF_POINTS = [
  { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"/>`,  label: "ISO-aligned processes"            },
  { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>`, label: "Real-time performance dashboards"   },
  { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"/>`,                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    label: "Pan-India field coverage"           },
  { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>`,                            label: "500+ trained brand representatives" },
] as const;

type Clr = "navy" | "grove";
const bg: Record<Clr, string> = {
  navy:  "bg-navy-50",
  grove: "bg-grove-50",
};
const txt: Record<Clr, string> = {
  navy:  "text-navy-700",
  grove: "text-grove-700",
};
---

<section id="insights" aria-labelledby="insights-heading" class="section-pad bg-white relative overflow-hidden">

  <div class="absolute inset-0 bg-grid opacity-40 pointer-events-none" aria-hidden="true"></div>
  <div
    class="absolute right-0 top-0 size-[500px] bg-navy-50 rounded-full opacity-40 blur-3xl translate-x-1/2 -translate-y-1/3 pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="wrap relative z-10">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-18">
      <p class="label-eyebrow reveal mb-4">Performance & Data</p>
      <div class="section-divider reveal delay-100 mx-auto mb-6"></div>
      <h2
        id="insights-heading"
        class="reveal delay-100 font-display font-extrabold text-navy-900 text-4xl lg:text-5xl tracking-tighter leading-[1.06] mb-5"
      >
        Measured. Refined. Scaled.
      </h2>
      <p class="reveal delay-200 text-lg text-warm-500 leading-relaxed">
        Every conversation we create is an insight. We track the metrics that matter and continuously refine strategies to deliver predictable, scalable performance.
      </p>
    </div>

    <!-- Metrics grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6 mb-10">
      {METRICS.map(({ target, suffix, prefix, decimals, label, sub, color }, i) => (
        <div class={`reveal delay-${(i % 3) * 100 + 100} ${bg[color]} rounded-2xl border border-warm-100 p-7 lg:p-8 relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300`}>
          <p
            class={`text-4xl lg:text-5xl font-black ${txt[color]} tabular-nums mb-2 counter-val`}
            data-target={target}
            data-suffix={suffix}
            data-prefix={prefix}
            data-decimals={decimals}
          >
            {prefix}{target}{suffix}
          </p>
          <p class="font-bold text-navy-900 text-[0.9375rem] mb-1">{label}</p>
          <p class="text-xs text-warm-400 font-medium">{sub}</p>
        </div>
      ))}
    </div>

    <!-- Two-column: what we track + business model -->
    <div class="grid md:grid-cols-2 gap-5 lg:gap-6 mb-10">

      <!-- What we track -->
      <div class="reveal bg-navy-900 rounded-2xl p-7 lg:p-8">
        <p class="text-[0.65rem] font-bold tracking-widest uppercase text-navy-400 mb-4">What We Track</p>
        <h3 class="text-xl font-bold text-white mb-6">Every Interaction Is an Insight</h3>
        <ul class="space-y-3">
          {TRACKED.map((item) => (
            <li class="flex items-center gap-3">
              <div class="size-5 rounded-full bg-grove-700 flex items-center justify-center flex-shrink-0">
                <svg class="size-3 text-white" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span class="text-sm font-semibold text-navy-100">{item}</span>
            </li>
          ))}
        </ul>
        <p class="text-xs text-navy-400 leading-relaxed mt-6">
          This data-driven discipline enables ongoing optimisation—delivering not just growth, but predictable, scalable performance.
        </p>
      </div>

      <!-- Business model -->
      <div class="reveal delay-100 bg-warm-50 rounded-2xl border border-warm-200 p-7 lg:p-8">
        <p class="label-eyebrow mb-4">Business Model</p>
        <h3 class="text-xl font-bold text-navy-900 mb-4 leading-snug">Built for Strategic Expansion</h3>
        <p class="text-sm text-warm-500 leading-relaxed mb-6">
          Our hybrid growth framework combines proprietary operational hubs with strategic partner networks—enabling rapid market expansion while maintaining uniform quality, control, and performance standards worldwide.
        </p>
        <div class="space-y-3">
          {(
            [
              { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 21h16.5M4.5 3h15M5.25 3v18m13.5-18v18M9 6.75h1.5m-1.5 3h1.5m-1.5 3h1.5m3-6H15m-1.5 3H15m-1.5 3H15M9 21v-3.375c0-.621.504-1.125 1.125-1.125h3.75c.621 0 1.125.504 1.125 1.125V21"/>`, label: "Proprietary Operational Hubs" },
              { icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 100 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186l9.566-5.314m-9.566 7.5l9.566 5.314m0 0a2.25 2.25 0 103.935 2.186 2.25 2.25 0 00-3.935-2.186zm0-12.814a2.25 2.25 0 103.933-2.185 2.25 2.25 0 00-3.933 2.185z"/>`,  label: "Strategic Partner Networks"    },
            ] as const
          ).map(({ icon, label }) => (
            <div class="flex items-center gap-3 bg-white rounded-xl border border-warm-200 px-4 py-3">
              <div class="size-8 bg-navy-50 rounded-lg flex items-center justify-center flex-shrink-0">
                <svg class="size-4 text-navy-700" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                  <Fragment set:html={icon} />
                </svg>
              </div>
              <span class="text-sm font-semibold text-navy-900">{label}</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Proof points strip -->
    <div class="reveal delay-300 bg-navy-950 rounded-2xl p-6 lg:p-7">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {PROOF_POINTS.map(({ icon, label }) => (
          <div class="flex items-center gap-3">
            <div class="size-9 bg-navy-800 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="size-4.5 text-grove-400 size-5" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icon} />
              </svg>
            </div>
            <span class="text-sm font-semibold text-navy-100">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
