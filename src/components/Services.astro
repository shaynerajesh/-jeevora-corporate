---
const SERVICES = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>`,
    title:       "Field Marketing Direct",
    description: "High-efficiency customer acquisition through expertly trained brand ambassadors who represent your proposition at the highest-impact touchpoints—in the field, face-to-face.",
    tags:        ["Customer Acquisition", "Brand Representation", "Direct Conversion"],
    color:       "navy",
    featured:    false,
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z"/>`,
    title:       "Retail Activation",
    description: "Targeted in-store campaigns strategically designed to influence purchase decisions at the precise moment they occur—converting foot traffic into committed buyers.",
    tags:        ["In-Store Strategy", "Point of Sale", "Shopper Marketing"],
    color:       "grove",
    featured:    true,
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3v11.25A2.25 2.25 0 006 16.5h2.25M3.75 3h-1.5m1.5 0h16.5m0 0h1.5m-1.5 0v11.25A2.25 2.25 0 0118 16.5h-2.25m-7.5 0h7.5m-7.5 0l-1 3m8.5-3l1 3m0 0l.5 1.5m-.5-1.5h-9.5m0 0l-.5 1.5M9 11.25v1.5M12 9v3.75m3-6v6"/>`,
    title:       "Experiential Campaigns",
    description: "Immersive brand experiences engineered to engage, educate, and convert. We design moments that make your brand memorable—and your proposition undeniable.",
    tags:        ["Brand Immersion", "Live Engagement", "Event Marketing"],
    color:       "teal",
    featured:    false,
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>`,
    title:       "Contact Centre Solutions",
    description: "Precision-driven outbound and inbound engagement that accelerates closing cycles. Every call is purposeful, every conversation moves the pipeline forward.",
    tags:        ["Outbound Sales", "Inbound Support", "Pipeline Acceleration"],
    color:       "navy",
    featured:    false,
  },
] as const;

type C = "navy" | "grove" | "teal";
const accent: Record<C, { icon: string; tag: string; border: string }> = {
  navy:  { icon: "bg-navy-50 text-navy-700",   tag: "bg-navy-50 text-navy-600 border-navy-100",   border: "border-navy-200"   },
  grove: { icon: "bg-grove-50 text-grove-700", tag: "bg-grove-50 text-grove-600 border-grove-100", border: "border-grove-200" },
  teal:  { icon: "bg-teal-400/10 text-teal-500", tag: "bg-teal-50/50 text-teal-500 border-teal-500/20", border: "border-teal-500/30" },
};
---

<section id="services" aria-labelledby="services-heading" class="section-pad bg-warm-50 relative overflow-hidden">

  <div class="wrap">

    <!-- Header -->
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6 mb-14 lg:mb-16">
      <div>
        <p class="label-eyebrow reveal mb-4">What We Deliver</p>
        <div class="section-divider reveal delay-100 mb-6"></div>
        <h2
          id="services-heading"
          class="reveal delay-100 font-display font-extrabold text-navy-900 text-4xl lg:text-5xl tracking-tighter leading-[1.06]"
        >
          Integrated Multi-Channel<br />Revenue Solutions
        </h2>
      </div>
      <p class="reveal delay-200 text-base text-warm-500 leading-relaxed max-w-sm lg:text-right">
        We implement cohesive sales strategies across high-impact engagement points—designed for conversion, built for scale.
      </p>
    </div>

    <!-- Services grid -->
    <div class="grid sm:grid-cols-2 gap-5 lg:gap-6">
      {SERVICES.map(({ icon, title, description, tags, color, featured }, i) => {
        const a = accent[color];
        return (
          <div class={`reveal delay-${(i % 2) * 150 + 100} group relative flex flex-col bg-white rounded-2xl border transition-all duration-300 p-7 lg:p-8 overflow-hidden
            ${featured
              ? "border-grove-300 shadow-lg shadow-grove-900/10 ring-2 ring-grove-300"
              : `border-warm-200 hover:shadow-xl hover:shadow-navy-900/8 hover:-translate-y-1.5 hover:${a.border}`}
          `}>
            {featured && (
              <div class="absolute top-0 inset-x-0 h-0.5 bg-gradient-to-r from-grove-500 to-grove-700"></div>
            )}
            {featured && (
              <span class="absolute top-5 right-5 px-2.5 py-1 bg-grove-700 text-white text-xs font-bold rounded-full">
                Core Service
              </span>
            )}

            <!-- Icon -->
            <div class={`size-12 rounded-2xl flex items-center justify-center mb-5 flex-shrink-0 ${a.icon}`}>
              <svg class="size-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icon} />
              </svg>
            </div>

            <h3 class="text-lg font-bold text-navy-900 mb-2.5">{title}</h3>
            <p class="text-sm text-warm-500 leading-relaxed mb-5 flex-1">{description}</p>

            <!-- Tags -->
            <div class="flex flex-wrap gap-2 mb-5">
              {tags.map((tag) => (
                <span class={`text-xs font-semibold px-2.5 py-1 rounded-full border ${a.tag}`}>{tag}</span>
              ))}
            </div>

            <a
              href="#contact"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-navy-700 hover:text-grove-700 transition-colors group/link"
            >
              Learn more
              <svg class="size-3.5 group-hover/link:translate-x-1 transition-transform" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        );
      })}
    </div>

    <!-- Bottom CTA -->
    <div class="reveal delay-400 text-center mt-12 lg:mt-16">
      <p class="text-sm text-warm-400 mb-4">Require a bespoke solution? We architect custom engagement strategies for complex markets.</p>
      <a href="#contact" class="btn-primary">
        Discuss Your Requirements
        <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>
  </div>
</section>
