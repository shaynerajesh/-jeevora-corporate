---
const ICON = `<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>`;

const TAGS = [
  "Customer Acquisition",
  "Brand Representation",
  "Face-to-Face Engagement",
] as const;
---

<section id="services" aria-labelledby="services-heading" class="section-pad bg-warm-50 relative overflow-hidden">

  <div
    class="absolute top-0 right-0 size-80 bg-navy-50 rounded-full blur-3xl opacity-60 translate-x-1/3 -translate-y-1/2 pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="wrap relative z-10">

    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
      <p class="label-eyebrow reveal mb-4">What We Deliver</p>
      <div class="section-divider reveal delay-100 mx-auto mb-6"></div>
      <h2
        id="services-heading"
        class="reveal delay-100 font-display font-extrabold text-navy-900 text-4xl lg:text-5xl tracking-tighter leading-[1.06] mb-5"
      >
        Field Marketing Direct
      </h2>
      <p class="reveal delay-200 text-lg text-warm-500 leading-relaxed">
        Human-led brand representation in the field—where trust is built face-to-face and every conversation carries your brand forward.
      </p>
    </div>

    <!-- Featured service card -->
    <div class="reveal delay-200 max-w-3xl mx-auto">
      <article class="
        group relative flex flex-col
        bg-white rounded-3xl border border-warm-200
        p-8 sm:p-10 lg:p-12
        shadow-[0_4px_24px_-4px_rgba(27,53,117,0.08)]
        hover:shadow-[0_16px_48px_-12px_rgba(27,53,117,0.12)]
        hover:-translate-y-1 transition-all duration-300
        overflow-hidden
      ">
        <div
          class="absolute top-0 inset-x-0 h-0.5 bg-gradient-to-r from-grove-500 via-teal-500/80 to-navy-600"
          aria-hidden="true"
        ></div>

        <div class="flex flex-col lg:flex-row lg:items-start gap-8 lg:gap-10">
          <div class="flex-shrink-0">
            <div class="size-14 rounded-2xl bg-navy-50 text-navy-700 flex items-center justify-center">
              <svg class="size-7" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={ICON} />
              </svg>
            </div>
          </div>

          <div class="flex-1 min-w-0">
            <p class="text-[0.65rem] font-bold tracking-widest uppercase text-grove-600 mb-3">Our Core Offering</p>
            <h3 class="text-2xl lg:text-3xl font-bold text-navy-900 tracking-tight mb-4">
              Presence where it matters most
            </h3>
            <p class="text-base text-warm-500 leading-relaxed mb-6">
              Expertly trained brand ambassadors represent your proposition at the highest-impact touchpoints—in the field, face-to-face. We create genuine conversations that build confidence, deepen trust, and move people toward meaningful decisions.
            </p>

            <div class="flex flex-wrap gap-2 mb-8">
              {TAGS.map((tag) => (
                <span class="text-xs font-semibold px-3 py-1.5 rounded-full border bg-navy-50 text-navy-600 border-navy-100">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href="#contact"
              class="btn-primary inline-flex"
            >
              Start a Conversation
              <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        </div>
      </article>
    </div>

    <!-- Bottom note -->
    <div class="reveal delay-300 text-center mt-12 lg:mt-14 max-w-md mx-auto">
      <p class="text-sm text-warm-400 leading-relaxed">
        Every engagement is tailored to your brand, market, and audience—with disciplined execution and authentic human connection at the centre.
      </p>
    </div>
  </div>
</section>
