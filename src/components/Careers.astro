---
const CULTURE = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18L9 11.25l4.306 4.307a11.95 11.95 0 015.814-5.519l2.74-1.22m0 0l-5.94-2.28m5.94 2.28l-2.28 5.941"/>`,
    title:       "Accelerated Professional Growth",
    description: "Our structure rewards performance with speed. High-achievers move through responsibility levels faster than any traditional corporate path.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"/>`,
    title:       "Leadership Development",
    description: "We invest in our people the way we invest in campaigns—deliberately, with defined outcomes. Every team member has a visible progression pathway.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    title:       "Financial Independence",
    description: "Performance-linked compensation means your earnings are determined by your results—not by a fixed ceiling or annual review.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M13.5 21v-7.5a.75.75 0 01.75-.75h3a.75.75 0 01.75.75V21m-4.5 0H2.36m11.14 0H18m0 0h3.64m-1.39 0V9.349m-16.5 11.65V9.35m0 0a3.001 3.001 0 003.75-.615A2.993 2.993 0 009.75 9.75c.896 0 1.7-.393 2.25-1.016a2.993 2.993 0 002.25 1.016c.896 0 1.7-.393 2.25-1.015a3.001 3.001 0 003.75.614m-16.5 0a3.004 3.004 0 01-.621-4.72L4.318 3.44A1.5 1.5 0 015.378 3h13.243a1.5 1.5 0 011.06.44l1.19 1.189a3 3 0 01-.621 4.72m-13.5 8.65h3.75a.75.75 0 00.75-.75V13.5a.75.75 0 00-.75-.75H6.75a.75.75 0 00-.75.75v3.75c0 .415.336.75.75.75z"/>`,
    title:       "Entrepreneurial Pathways",
    description: "For those who demonstrate leadership, we offer business ownership pathways—building your own operation within our framework.",
  },
] as const;

const ROLES = [
  { title: "Brand Growth Executive",     type: "Full-time", location: "Mumbai / Pune",   dept: "Field Marketing", badge: "Actively Hiring", badgeColor: "bg-grove-50 text-grove-700 border-grove-200" },
  { title: "Retail Activation Specialist", type: "Full-time", location: "Bangalore",     dept: "Retail",          badge: "Actively Hiring", badgeColor: "bg-grove-50 text-grove-700 border-grove-200" },
  { title: "Team Leader — Field Sales",  type: "Full-time", location: "Pan-India",       dept: "Leadership",      badge: "Senior Role",     badgeColor: "bg-navy-50 text-navy-700 border-navy-200"    },
  { title: "Contact Centre Executive",   type: "Full-time", location: "Hyderabad",       dept: "Contact Centre",  badge: "Multiple Seats",  badgeColor: "bg-navy-50 text-navy-700 border-navy-200"    },
] as const;
---

<section id="careers" aria-labelledby="careers-heading" class="section-pad bg-warm-50 relative overflow-hidden">

  <div class="wrap">

    <!-- Header -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start mb-14 lg:mb-18">
      <div>
        <p class="label-eyebrow reveal mb-4">Careers</p>
        <div class="section-divider reveal delay-100 mb-6"></div>
        <h2
          id="careers-heading"
          class="reveal delay-100 font-display font-extrabold text-navy-900 text-4xl lg:text-5xl tracking-tighter leading-[1.06] mb-5"
        >
          More Than a Job—<br />A Leadership Journey
        </h2>
        <p class="reveal delay-200 text-base text-warm-500 leading-relaxed mb-6">
          We don't offer positions. We cultivate future leaders and entrepreneurs. Our culture is built for individuals who seek accelerated growth, commercial ownership, and the opportunity to build something that lasts.
        </p>
        <div class="reveal delay-300 bg-navy-700 text-white rounded-2xl p-5 mb-6">
          <p class="text-xs font-bold tracking-widest uppercase text-navy-200 mb-2">The Fast Track</p>
          <p class="text-base font-bold leading-snug">
            For high performers, the path from entry-level to leadership is clear—achievable within 12 to 24 months.
          </p>
        </div>
        <div class="reveal delay-400">
          <a href="#contact" class="btn-green">
            View Open Roles
            <svg class="size-4" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Culture pillars -->
      <div class="grid sm:grid-cols-2 gap-4">
        {CULTURE.map(({ icon, title, description }, i) => (
          <div class={`reveal delay-${i * 100 + 100} bg-white rounded-2xl border border-warm-200 p-5 hover:shadow-md hover:-translate-y-0.5 transition-all duration-300`}>
            <div class="size-10 bg-navy-50 rounded-xl flex items-center justify-center mb-4">
              <svg class="size-5 text-navy-700" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                <Fragment set:html={icon} />
              </svg>
            </div>
            <h3 class="font-bold text-navy-900 text-sm mb-1.5">{title}</h3>
            <p class="text-xs text-warm-500 leading-relaxed">{description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Roles -->
    <div>
      <div class="flex items-center justify-between mb-6">
        <h3 class="reveal text-xl font-bold text-navy-900">Current Openings</h3>
        <span class="reveal delay-100 text-xs font-semibold text-warm-400 bg-warm-200 px-3 py-1.5 rounded-full">
          {ROLES.length} positions available
        </span>
      </div>

      <div class="space-y-3">
        {ROLES.map(({ title, type, location, dept, badge, badgeColor }, i) => (
          <div class={`reveal delay-${i * 75} group bg-white rounded-2xl border border-warm-200 px-5 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:border-navy-300 hover:shadow-md transition-all duration-200`}>
            <div class="flex items-start sm:items-center gap-4">
              <div class="size-10 bg-navy-50 rounded-xl flex-shrink-0 flex items-center justify-center">
                <svg class="size-5 text-navy-700" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.837-2.175a48.114 48.114 0 00-3.413-.387m4.5 8.006c-.194.165-.42.295-.673.38A23.978 23.978 0 0112 15.75c-2.648 0-5.195-.429-7.577-1.22a2.016 2.016 0 01-.673-.38m0 0A2.18 2.18 0 013 12.489V8.706c0-1.081.768-2.015 1.837-2.175a48.111 48.111 0 013.413-.387m7.5 0V5.25A2.25 2.25 0 0013.5 3h-3a2.25 2.25 0 00-2.25 2.25v.894m7.5 0a48.667 48.667 0 00-7.5 0M12 12.75h.008v.008H12v-.008z"/>
                </svg>
              </div>
              <div>
                <div class="flex flex-wrap items-center gap-2 mb-1">
                  <h4 class="font-bold text-navy-900 text-sm">{title}</h4>
                  <span class={`text-xs font-semibold px-2 py-0.5 rounded-full border ${badgeColor}`}>{badge}</span>
                </div>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                  <span class="text-xs text-warm-400 font-medium">{location}</span>
                  <span class="size-1 rounded-full bg-warm-300" aria-hidden="true"></span>
                  <span class="text-xs text-warm-400 font-medium">{type}</span>
                  <span class="size-1 rounded-full bg-warm-300" aria-hidden="true"></span>
                  <span class="text-xs text-warm-400 font-medium">{dept}</span>
                </div>
              </div>
            </div>
            <a
              href="#contact"
              class="flex-shrink-0 inline-flex items-center gap-1.5 px-4 py-2 bg-navy-700 text-white text-xs font-bold rounded-full hover:bg-navy-800 transition-colors"
            >
              Apply Now
              <svg class="size-3" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                <path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Speculative application -->
      <div class="reveal delay-400 mt-5 bg-navy-950 rounded-2xl p-5 px-6 flex flex-col sm:flex-row items-center justify-between gap-4">
        <div>
          <p class="font-bold text-white text-sm mb-0.5">Don't see your role?</p>
          <p class="text-xs text-navy-300">We build teams around exceptional people. Send us your profile.</p>
        </div>
        <a
          href="#contact"
          class="flex-shrink-0 inline-flex items-center gap-2 px-5 py-2.5 text-sm font-bold text-white border-2 border-navy-600 hover:border-white rounded-full transition-colors"
        >
          Send Open Application
        </a>
      </div>
    </div>
  </div>
</section>
