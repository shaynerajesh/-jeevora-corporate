---
const FOCUSES = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/>`,
    title: "Genuine Interactions",
    description: "Not scripted. Not automated. Real conversations between trained human beings and real customers—at the exact moment decisions are made.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>`,
    title: "Reliable Data",
    description: "Every claim we make is substantiated. Every strategy we recommend is grounded in verified performance data—not assumptions or industry averages.",
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`,
    title: "Measurable Outcomes",
    description: "Growth is not a feeling—it is a number. We define success in revenue, acquisition volume, retention rate, and return on investment. Nothing less.",
  },
] as const;
---

<section id="philosophy" aria-labelledby="philosophy-heading" class="section-pad relative overflow-hidden">

  <!-- Deep navy background -->
  <div class="absolute inset-0 bg-navy-950" aria-hidden="true"></div>
  <div class="absolute inset-0 bg-grid opacity-15" aria-hidden="true"></div>
  <div
    class="absolute bottom-0 left-1/4 size-[600px] bg-grove-900/30 rounded-full blur-3xl pointer-events-none"
    aria-hidden="true"
  ></div>

  <div class="wrap relative z-10">

    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-14 lg:mb-18">
      <p class="reveal mb-4 text-[0.7rem] font-bold tracking-[0.14em] uppercase text-grove-400">Our Philosophy</p>
      <div class="reveal delay-100 section-divider mx-auto mb-6" style="background-color:var(--color-grove-600);"></div>
      <h2
        id="philosophy-heading"
        class="reveal delay-100 font-display font-extrabold text-white text-4xl lg:text-5xl tracking-tighter leading-[1.06] mb-5"
      >
        Growth Driven by Data<br />and Authenticity
      </h2>
      <p class="reveal delay-200 text-lg text-navy-300 leading-relaxed">
        We reject ambiguous marketing claims. Sustainable growth is founded not on visibility alone—but on consistent conversion and accountability.
      </p>
    </div>

    <!-- Three pillars -->
    <div class="grid md:grid-cols-3 gap-5 lg:gap-6 mb-12 lg:mb-16">
      {FOCUSES.map(({ icon, title, description }, i) => (
        <div class={`reveal delay-${i * 150 + 100} group bg-white/5 hover:bg-white/8 border border-white/10 hover:border-white/20 rounded-2xl p-7 transition-all duration-300`}>
          <div class="size-11 bg-navy-800 group-hover:bg-grove-700 rounded-xl flex items-center justify-center mb-5 transition-colors duration-300">
            <svg class="size-5 text-grove-400 group-hover:text-white transition-colors duration-300" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24" aria-hidden="true">
              <Fragment set:html={icon} />
            </svg>
          </div>
          <h3 class="font-bold text-white text-base mb-2.5">{title}</h3>
          <p class="text-sm text-navy-300 leading-relaxed">{description}</p>
        </div>
      ))}
    </div>

    <!-- Closing manifesto -->
    <div class="reveal delay-400 max-w-3xl mx-auto text-center">
      <blockquote class="text-xl lg:text-2xl font-bold text-white leading-relaxed mb-6">
        "Sustainable growth is not built on visibility—<br class="hidden md:block"/>
        <span class="text-grove-400">it is built on conversion and consistency."</span>
      </blockquote>
      <p class="text-sm text-navy-300 leading-relaxed">
        This principle governs every campaign we run, every team we deploy, and every client relationship we build.
      </p>
    </div>
  </div>
</section>
